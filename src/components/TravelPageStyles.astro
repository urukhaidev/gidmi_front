<style is:global>
	:root {
		--site-gutter: 24px;
		--site-content-max: 1200px;
	}

	body {
		margin: 0;
		color: #1f2420;
		background: #fff;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(31, 36, 32, 0.1);
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(14px);
	}

	header nav {
		display: flex;
		align-items: center;
		gap: 18px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 14px 24px;
	}

	header nav > a:first-child {
		margin-right: auto;
		color: #1f2420;
		text-decoration: none;
	}

	header nav a {
		color: #3f463f;
		text-decoration: none;
	}

	main {
		overflow: hidden;
	}

	.page-hero {
		position: relative;
		display: grid;
		align-items: end;
		min-height: 360px;
		color: #fff;
		background:
			linear-gradient(135deg, #0486fe, #7f6749 58%, #25332e),
			#0486fe;
		overflow: hidden;
	}

	.page-hero img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(12, 18, 16, 0.82), rgba(12, 18, 16, 0.32)),
			linear-gradient(0deg, rgba(12, 18, 16, 0.62), rgba(12, 18, 16, 0.08));
	}

	.page-hero__inner {
		position: relative;
		z-index: 1;
		width: min(var(--site-content-max), calc(100% - (var(--site-gutter) * 2)));
		margin: 0 auto;
		padding: 72px 0 48px;
	}

	.breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0 0 20px;
		color: rgba(255, 255, 255, 0.76);
		font-size: 0.94rem;
	}

	.breadcrumbs a {
		color: inherit;
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: #fff;
	}

	h1,
	h2,
	h3,
	p {
		text-wrap: pretty;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.4rem, 4.5vw, 3.75rem);
		line-height: 0.98;
		letter-spacing: 0;
	}

	.page-lead {
		max-width: 720px;
		margin: 18px 0 0;
		color: rgba(255, 255, 255, 0.86);
		font-size: 1.12rem;
		line-height: 1.6;
	}

	.section {
		max-width: var(--site-content-max);
		margin: 0 auto;
		padding: 24px var(--site-gutter);
	}

	.section__heading {
		margin-bottom: 24px;
	}

	.section__heading h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		line-height: 1;
	}

	.section__heading--row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 8px 16px;
		align-items: end;
	}

	.sort-menu {
		position: relative;
		justify-self: end;
	}

	.sort-menu summary {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		min-height: 34px;
		padding: 4px 0;
		color: #1f2420;
		cursor: pointer;
		font-size: 1.05rem;
		font-weight: 750;
		list-style: none;
	}

	.sort-menu summary::-webkit-details-marker {
		display: none;
	}

	.sort-menu__list {
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		z-index: 5;
		display: grid;
		min-width: 168px;
		padding: 6px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 12px 28px rgba(31, 36, 32, 0.12);
	}

	.sort-menu__link {
		padding: 8px 10px;
		border-radius: 6px;
		color: #3f463f;
		text-decoration: none;
		font-weight: 750;
	}

	.sort-menu__link--active {
		color: #fff;
		background: #0486fe;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 18px;
	}

	.excursion-filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: -6px 0 22px;
	}

	.filter-menu {
		position: relative;
	}

	.filter-menu summary {
		display: inline-flex;
		gap: 14px;
		align-items: center;
		min-height: 46px;
		padding: 0 20px;
		border-radius: 8px;
		color: #1f2420;
		background: #f1f1f1;
		cursor: pointer;
		font-size: 1rem;
		list-style: none;
		white-space: nowrap;
	}

	.filter-menu summary::-webkit-details-marker {
		display: none;
	}

	.filter-menu__list {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		z-index: 10;
		display: grid;
		min-width: 210px;
		padding: 6px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 14px 34px rgba(31, 36, 32, 0.14);
	}

	.filter-menu__note {
		padding: 8px 10px;
		color: #687067;
		font-size: 0.9rem;
	}

	.filter-menu__link {
		padding: 9px 10px;
		border-radius: 6px;
		color: #3f463f;
		text-decoration: none;
		font-weight: 750;
	}

	.filter-menu__link--active {
		color: #fff;
		background: #0486fe;
	}

	[data-excursion-results][aria-busy="true"] {
		opacity: 0.64;
		pointer-events: none;
	}

	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
		margin-top: 24px;
	}

	.pagination a,
	.pagination span {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		justify-content: center;
		min-width: 42px;
		min-height: 34px;
		padding: 4px 12px;
		border: 0;
		border-radius: 8px;
		color: #1f2420;
		background: #f1f1f1;
		font-size: 1.05rem;
		font-weight: 750;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.pagination span {
		color: #687067;
	}

	.pagination a:hover,
	.pagination .pagination__link--active,
	.pagination [aria-current="page"] {
		color: #fff;
		background: #0486fe;
	}

	.prose {
		max-width: 780px;
		font-size: 1.04rem;
		line-height: 1.7;
	}

	.prose p {
		margin-top: 0;
		margin-bottom: 1rem;
	}

	.prose p:last-child {
		margin-bottom: 0;
	}

	.prose ul,
	.prose ol {
		margin-top: 0;
		margin-bottom: 1rem;
		padding-left: 1.5rem;
		list-style-type: disc;
	}

	.prose ol {
		list-style-type: decimal;
	}

	.prose li {
		margin-bottom: 0.4rem;
	}

	.prose strong,
	.prose b {
		color: #1f2420;
		font-weight: 700;
	}

	.pill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pill-list a,
	.pill-list span {
		display: inline-flex;
		padding: 9px 12px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 999px;
		color: #1f2420;
		background: #fff;
		text-decoration: none;
		font-weight: 750;
	}

	.empty-card {
		padding: 24px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 8px;
		color: #555d54;
		background: #fff;
		line-height: 1.55;
	}

	.category-filter-list {
		display: flex;
		flex-wrap: wrap;
		gap: 7px !important;
	}

	.category-filter {
		display: inline-flex !important;
		align-items: center !important;
		min-height: 32px !important;
		padding: 5px 9px !important;
		gap: 7px !important;
		border: 1px solid rgba(31, 36, 32, 0.12) !important;
		border-radius: 8px !important;
		color: #1f2420 !important;
		background: #fff !important;
		font-size: 0.92rem !important;
		line-height: 1.15 !important;
		text-decoration: none !important;
		white-space: nowrap !important;
		box-sizing: border-box !important;
		flex-shrink: 0 !important;
	}

	.category-filter small {
		color: #687067;
		font-size: 0.86rem;
		font-weight: 600;
	}

	.category-filter--active {
		border-color: #0486fe !important;
		color: #fff !important;
		background: #0486fe !important;
	}

	.category-filter--active small {
		color: rgba(255, 255, 255, 0.78);
	}

	.category-filter--more {
		border-color: #0486fe !important;
		color: #0486fe !important;
		background: rgba(31, 115, 201, 0.05) !important;
		cursor: pointer;
	}

	.category-panel {
		display: grid;
		gap: 12px;
	}

	.category-panel__row {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.category-panel__row .category-filter--more {
		margin-left: auto;
	}

	.category-panel__label {
		color: #1f2420;
		font-size: 1.18rem;
		font-weight: 800;
	}

	@media (min-width: 761px) and (max-width: 1440px) {
		:root {
			--site-gutter: 48px;
			--site-content-max: 1104px;
		}
	}

	@media (max-width: 760px) {
		:root {
			--site-gutter: 18px;
			--site-content-max: 1200px;
		}

		header nav {
			align-items: flex-start;
			flex-wrap: wrap;
			padding: 14px 18px;
		}

		.page-hero__inner {
			padding: 52px 0 38px;
		}

		.section {
			padding-block: 24px;
		}

		.excursion-filter-bar {
			flex-wrap: nowrap;
			overflow-x: auto;
			margin-bottom: 18px;
			padding-bottom: 4px;
		}

		.category-panel > .category-filter-list {
			display: flex;
			flex-direction: column;
			flex-wrap: wrap;
			max-height: calc(2 * 32px + 7px);
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.category-panel > .category-filter-list::-webkit-scrollbar {
			display: none;
		}

		.filter-menu summary {
			min-height: 42px;
			padding: 0 14px;
			font-size: 0.95rem;
		}

		.section__heading--row {
			grid-template-columns: 1fr;
		}

		.sort-menu {
			justify-self: start;
		}
	}
</style>

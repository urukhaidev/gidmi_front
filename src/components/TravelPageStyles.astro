<style is:global>
	body {
		margin: 0;
		color: #1f2420;
		background: #fff;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(31, 36, 32, 0.1);
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(14px);
	}

	header nav {
		display: flex;
		align-items: center;
		gap: 18px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 14px 24px;
	}

	header nav > a:first-child {
		margin-right: auto;
		color: #1f2420;
		font-weight: 850;
		text-decoration: none;
	}

	header nav a {
		color: #3f463f;
		text-decoration: none;
		font-weight: 700;
	}

	main {
		overflow: hidden;
	}

	.page-hero {
		position: relative;
		display: grid;
		align-items: end;
		min-height: 360px;
		color: #fff;
		background:
			linear-gradient(135deg, #315d63, #7f6749 58%, #25332e),
			#315d63;
		overflow: hidden;
	}

	.page-hero img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(12, 18, 16, 0.82), rgba(12, 18, 16, 0.32)),
			linear-gradient(0deg, rgba(12, 18, 16, 0.62), rgba(12, 18, 16, 0.08));
	}

	.page-hero__inner {
		position: relative;
		z-index: 1;
		width: min(1200px, calc(100% - 48px));
		margin: 0 auto;
		padding: 72px 0 48px;
	}

	.breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0 0 20px;
		color: rgba(255, 255, 255, 0.76);
		font-size: 0.94rem;
	}

	.breadcrumbs a {
		color: inherit;
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: #fff;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #cfa464;
		font-size: 0.78rem;
		font-weight: 850;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		text-wrap: pretty;
	}

	h1 {
		max-width: 860px;
		margin: 0;
		font-size: clamp(2.7rem, 6vw, 5.4rem);
		line-height: 0.98;
		letter-spacing: 0;
	}

	.page-lead {
		max-width: 720px;
		margin: 18px 0 0;
		color: rgba(255, 255, 255, 0.86);
		font-size: 1.12rem;
		line-height: 1.6;
	}

	.section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 48px 24px;
	}

	.section__heading {
		margin-bottom: 24px;
	}

	.section__heading h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1;
	}

	.section__heading--row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 8px 16px;
		align-items: end;
	}

	.section__heading--row .eyebrow {
		grid-column: 1 / -1;
	}

	.sort-menu {
		position: relative;
		justify-self: end;
	}

	.sort-menu summary {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		min-height: 34px;
		padding: 4px 0;
		color: #1f2420;
		cursor: pointer;
		font-size: 1.05rem;
		font-weight: 750;
		list-style: none;
	}

	.sort-menu summary::-webkit-details-marker {
		display: none;
	}

	.sort-menu__list {
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		z-index: 5;
		display: grid;
		min-width: 168px;
		padding: 6px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 12px 28px rgba(31, 36, 32, 0.12);
	}

	.sort-menu__link {
		padding: 8px 10px;
		border-radius: 6px;
		color: #3f463f;
		text-decoration: none;
		font-weight: 750;
	}

	.sort-menu__link--active {
		color: #fff;
		background: #315d63;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 18px;
	}

	.excursion-filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: -6px 0 22px;
	}

	.filter-menu {
		position: relative;
	}

	.filter-menu summary {
		display: inline-flex;
		gap: 14px;
		align-items: center;
		min-height: 46px;
		padding: 0 20px;
		border-radius: 8px;
		color: #1f2420;
		background: #f1f1f1;
		cursor: pointer;
		font-size: 1rem;
		font-weight: 750;
		list-style: none;
		white-space: nowrap;
	}

	.filter-menu summary::-webkit-details-marker {
		display: none;
	}

	.filter-menu__list {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		z-index: 10;
		display: grid;
		min-width: 210px;
		padding: 6px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 14px 34px rgba(31, 36, 32, 0.14);
	}

	.filter-menu__note {
		padding: 8px 10px;
		color: #687067;
		font-size: 0.9rem;
	}

	.filter-menu__link {
		padding: 9px 10px;
		border-radius: 6px;
		color: #3f463f;
		text-decoration: none;
		font-weight: 750;
	}

	.filter-menu__link--active {
		color: #fff;
		background: #315d63;
	}

	[data-excursion-results][aria-busy="true"] {
		opacity: 0.64;
		pointer-events: none;
	}

	.prose {
		max-width: 780px;
		color: #3f463f;
		font-size: 1.04rem;
		line-height: 1.7;
	}

	.prose p {
		margin-top: 0;
		margin-bottom: 1rem;
	}

	.prose p:last-child {
		margin-bottom: 0;
	}

	.prose ul,
	.prose ol {
		margin-top: 0;
		margin-bottom: 1rem;
		padding-left: 1.5rem;
		list-style-type: disc;
	}

	.prose ol {
		list-style-type: decimal;
	}

	.prose li {
		margin-bottom: 0.4rem;
	}

	.prose strong,
	.prose b {
		color: #1f2420;
		font-weight: 700;
	}

	.pill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pill-list a,
	.pill-list span {
		display: inline-flex;
		padding: 9px 12px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 999px;
		color: #1f2420;
		background: #fff;
		text-decoration: none;
		font-weight: 750;
	}

	.empty-card {
		padding: 24px;
		border: 1px solid rgba(31, 36, 32, 0.12);
		border-radius: 8px;
		color: #555d54;
		background: #fff;
		line-height: 1.55;
	}

	.category-filter-list {
		gap: 7px !important;
	}

	.category-filter {
		min-height: 32px !important;
		padding: 5px 9px !important;
		gap: 7px !important;
		font-size: 0.92rem !important;
		line-height: 1.15 !important;
		white-space: nowrap !important;
		box-sizing: border-box !important;
	}

	@media (max-width: 760px) {
		header nav {
			align-items: flex-start;
			flex-wrap: wrap;
			padding: 14px 18px;
		}

		.page-hero__inner {
			width: min(100% - 36px, 1200px);
			padding: 52px 0 38px;
		}

		.section {
			padding: 38px 18px;
		}

		.excursion-filter-bar {
			flex-wrap: nowrap;
			overflow-x: auto;
			margin-bottom: 18px;
			padding-bottom: 4px;
		}

		.filter-menu summary {
			min-height: 42px;
			padding: 0 14px;
			font-size: 0.95rem;
		}

		.section__heading--row {
			grid-template-columns: 1fr;
		}

		.sort-menu {
			justify-self: start;
		}
	}
</style>

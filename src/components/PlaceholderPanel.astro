---
interface Props {
	title: string;
	text: string;
	actionLabel: string;
	actionHref: string;
	icon?: "heart" | "chat";
}
const { title, text, actionLabel, actionHref, icon = "chat" } = Astro.props;
const icons = {
	heart: "M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z",
	chat: "M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z",
};
---

<section class="placeholder-panel">
	<span class="placeholder-panel__icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[icon]} /></svg>
	</span>
	<span class="placeholder-panel__label">Раздел готовится</span>
	<h2>{title}</h2>
	<p>{text}</p>
	<a href={actionHref}>{actionLabel}<span aria-hidden="true"> →</span></a>
</section>

<style>
	.placeholder-panel { padding: 40px 24px; border: 1px solid #e3e8ed; border-radius: 16px; text-align: center; background: #fafcfe; }
	.placeholder-panel__icon { display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 18px; background: #eaf4ff; color: #0486fe; }
	.placeholder-panel__icon svg { width: 30px; height: 30px; }
	.placeholder-panel__label { color: #687b8d; font-size: 13px; }
	.placeholder-panel h2 { margin: 12px 0; font-size: 24px; line-height: 1.35; }
	.placeholder-panel p { max-width: 520px; margin: 0 auto 24px; }
	.placeholder-panel a { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 8px; background: #0486fe; color: #fff; text-decoration: none; font-weight: 600; }
	.placeholder-panel a:hover { background: #006fd7; }
	.placeholder-panel a:focus-visible { outline: 3px solid #79beff; outline-offset: 3px; }
</style>

---
import { experienceHref, type ExperienceRow } from "../lib/travel-db.js";

const { experience, showCity = true } = Astro.props;

const formatCount = (value: number | string | null | undefined) => Number(value ?? 0).toLocaleString("ru-RU");
const formatDuration = (value: number | string | null | undefined) => {
	const duration = String(value ?? "").trim().replace(/\s*ч\.?$/i, "");
	return duration.replace(/([.,]\d*?)0+$/, "$1").replace(/[.,]$/, "");
};
const typeLabels: Record<string, string> = {
	private: "Индивидуальная",
	individual: "Индивидуальная",
	group: "Групповая",
	mini_group: "Мини-группа",
	"mini-group": "Мини-группа",
	minigroup: "Мини-группа",
	small_group: "Мини-группа",
	"small-group": "Мини-группа",
};
const movementLabels: Record<string, string> = {
	foot: "пешком",
	car: "на машине",
	bus: "на автобусе",
	museum: "в музее",
	motorship: "на теплоходе",
	speedboat: "на катере",
	boat: "на лодке",
	yacht: "на яхте",
	sailing: "на яхте",
	bicycle: "на велосипеде",
	other: "другое",
};
const formatLabels: Record<string, string> = {
	waterwalk: "на воде",
	quest: "квест",
	photosession: "фотосессия",
	activity: "активность",
	master_class: "мастер-класс",
	audioguide: "аудиогид",
	ticket: "билет",
};
const labelFor = (labels: Record<string, string>, value: string | null | undefined) => {
	const key = String(value ?? "").trim().toLowerCase();
	return key ? labels[key] : null;
};
const badgeLabel = [
	labelFor(typeLabels, experience.type),
	labelFor(movementLabels, experience.movement_type) ?? labelFor(formatLabels, experience.format),
].filter(Boolean).join(" ∙ ");
const formatPrice = (item: ExperienceRow) => {
	if (item.price_value_string) return item.price_value_string;
	if (!item.price_value) return null;

	const price = Number(item.price_value);
	const currency = String(item.price_currency ?? "RUB").trim() || "RUB";

	if (Number.isNaN(price)) return null;

	try {
		return new Intl.NumberFormat("ru-RU", {
			style: "currency",
			currency,
			maximumFractionDigits: 0,
		}).format(price);
	} catch {
		return `${price.toLocaleString("ru-RU")} ${currency}`;
	}
};
---

<article class="experience-card">
	<a href={experienceHref(experience)}>
		<div class="experience-card__media">
			{
				experience.image_url && (
					<img src={experience.image_url} alt="" loading="lazy" />
				)
			}
			{badgeLabel && <span class="experience-card__badge">{badgeLabel}</span>}
		</div>
		<div class="experience-card__body">
			<div class="experience-card__meta">
				{experience.duration && <span><span class="experience-card__meta-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm1 3v5.1l3.4 2-1 1.7L11 13.2V7h2Z" /></svg></span>{formatDuration(experience.duration)} ч.</span>}
				{experience.rating && <span><span class="experience-card__meta-icon" aria-hidden="true">★</span>{experience.rating}</span>}
				{
					experience.review_count && (
						<span><span class="experience-card__meta-icon" aria-hidden="true"><svg class="experience-card__meta-icon--reviews" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16v10H9.5L4 19.5v-14Z" /><path d="m12 14.6-3.1-2.9a2 2 0 0 1 2.8-2.8l.3.3.3-.3a2 2 0 0 1 2.8 2.8L12 14.6Z" /></svg></span>{formatCount(experience.review_count)} отзывов</span>
					)
				}
			</div>
			<h3>{experience.title}</h3>
			{experience.tagline && <p>{experience.tagline}</p>}
			<div class="experience-card__footer">
				{formatPrice(experience) && <strong>{formatPrice(experience)}</strong>}
				{showCity && experience.city_name && <span>{experience.city_name}</span>}
			</div>
		</div>
	</a>
</article>

<style>
	.experience-card {
		border-radius: 8px;
		background: #fff;
		overflow: hidden;
		box-shadow: 0 1px 0 rgba(31, 36, 32, 0.08);
	}

	.experience-card a {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.experience-card__media {
		position: relative;
		height: 210px;
		background:
			linear-gradient(135deg, rgba(49, 93, 99, 0.9), rgba(127, 103, 73, 0.9)),
			#0486fe;
		overflow: hidden;
	}

	.experience-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.experience-card__media::after {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 42%;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0));
		pointer-events: none;
	}

	.experience-card__badge {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 1;
		max-width: calc(100% - 28px);
		color: #fff;
		font-size: 0.98rem;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.experience-card__body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 20px;
		flex: 1;
	}

	.experience-card__meta,
	.experience-card__footer {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
		color: #687067;
		font-size: 0.92rem;
	}

	.experience-card__meta span {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.experience-card__meta-icon {
		display: inline-grid;
		place-items: center;
		width: 16px;
		height: 16px;
		color: #0486fe;
		flex: 0 0 auto;
	}

	.experience-card__meta-icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}

	.experience-card__meta-icon svg.experience-card__meta-icon--reviews {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.experience-card h3 {
		margin: 0;
		font-size: 1.18rem;
		line-height: 1.22;
	}

	.experience-card p {
		margin: 0;
		color: #555d54;
		line-height: 1.5;
	}

	.experience-card__footer {
		margin-top: auto;
		justify-content: space-between;
	}

	.experience-card__footer strong {
		color: #1f2420;
		font-size: 1.05rem;
	}

	@media (max-width: 760px) {
		.experience-card__media {
			height: 190px;
		}
	}
</style>

---
import { Image } from "emdash/ui";
import type { EmDashCollections } from "emdash";

interface Props {
	post: { id: string; data: EmDashCollections["posts"] };
	tags?: { slug: string; label: string }[];
}
const { post, tags = [] } = Astro.props;
const href = `/blog/${encodeURIComponent(post.id)}`;
---

<article class="blog-card">
	<a class="blog-card__cover" href={href} aria-label={post.data.title}>
		{post.data.featured_image
			? <Image image={post.data.featured_image} />
			: <span class="blog-card__placeholder" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z" /><path d="M9 3v15M15 6v15" /></svg><span>Гидми · Журнал путешествий</span></span>}
	</a>
	<div class="blog-card__body">
		{post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" })}</time>}
		<h2><a href={href}>{post.data.title}</a></h2>
		{post.data.excerpt && <p>{post.data.excerpt}</p>}
		{tags.length > 0 && <ul class="blog-card__tags">{tags.map((tag) => <li><a href={`/blog?tag=${encodeURIComponent(tag.slug)}`}>{tag.label}</a></li>)}</ul>}
		<a class="blog-card__read" href={href}>Читать статью <span aria-hidden="true">→</span></a>
	</div>
</article>

<style>
	.blog-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #e3e8ed; border-radius: 14px; background: #fff; }
	.blog-card__cover { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #edf5fc; color: #408bc8; text-decoration: none; }
	.blog-card__cover :global(figure) { margin: 0; width: 100%; height: 100%; }
	.blog-card__cover :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
	.blog-card__placeholder { display: grid; place-content: center; justify-items: center; gap: 18px; height: 100%; background: linear-gradient(135deg, #edf7ff, #e7efed); font-size: 13px; }
	.blog-card__placeholder svg { width: 60px; height: 60px; }
	.blog-card__body { display: flex; flex-direction: column; flex: 1; padding: 24px; }
	.blog-card time { margin-bottom: 12px; font-size: 13px; color: #687b8d; }
	.blog-card h2 { margin: 0 0 12px; font-size: 22px; line-height: 1.4; overflow-wrap: anywhere; }
	.blog-card h2 a { color: #1f2420; text-decoration: none; }
	.blog-card h2 a:hover { color: #0475df; }
	.blog-card p { margin: 0 0 20px; font-size: 15px; line-height: 1.7; color: #596259; }
	.blog-card__tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; padding: 0; list-style: none; }
	.blog-card__tags a { display: block; padding: 5px 10px; border-radius: 20px; color: #52616f; background: #f1f5f8; font-size: 12px; text-decoration: none; }
	.blog-card__read { margin-top: auto; padding-top: 8px; color: #0475df; font-size: 14px; font-weight: 600; text-decoration: none; }
	.blog-card a:focus-visible { outline: 3px solid #79beff; outline-offset: -3px; }
</style>

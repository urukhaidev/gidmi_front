---
const {
	href,
	name,
	count,
	image,
	label = "экскурсий",
	secondaryCount = null,
	secondaryLabel = "гидов",
} = Astro.props;

const formatCount = (value: number | string | null | undefined) => Number(value ?? 0).toLocaleString("ru-RU");
---

<a class="place-card" href={href}>
	<div class="place-card__media">
		{image && <img src={image} alt="" loading="lazy" />}
	</div>
	<div class="place-card__body">
		<h3>{name}</h3>
		<p>
			<span>{formatCount(count)} {label}</span>
			{
				secondaryCount !== null && secondaryCount !== undefined && Number(secondaryCount) > 0 && (
					<span>{formatCount(secondaryCount)} {secondaryLabel}</span>
				)
			}
		</p>
	</div>
</a>

<style>
	.place-card {
		display: grid;
		grid-template-columns: 108px 1fr;
		min-height: 118px;
		border-radius: 8px;
		color: #1f2420;
		background: #fff;
		text-decoration: none;
		overflow: hidden;
		box-shadow: 0 1px 0 rgba(31, 36, 32, 0.08);
	}

	.place-card__media {
		height: 118px;
		background:
			linear-gradient(135deg, rgba(49, 93, 99, 0.9), rgba(127, 103, 73, 0.9)),
			#315d63;
		overflow: hidden;
	}

	.place-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.place-card__body {
		padding: 18px;
	}

	h3 {
		margin: 0;
		font-size: 1.16rem;
		line-height: 1.22;
	}

	p {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
		margin: 8px 0 0;
		color: #687067;
	}
</style>

---
import Base from "./Base.astro";

interface Props {
	title: string;
	description: string;
	draft?: boolean;
}

const { title, description, draft = false } = Astro.props;
---

<Base title={title} pageTitle={title} description={description}>
	<article class="information-page">
		<nav class="information-page__breadcrumbs" aria-label="Хлебные крошки">
			<a href="/">Главная</a><span aria-hidden="true">/</span><span>{title}</span>
		</nav>
		<h1>{title}</h1>
		{draft && <p class="information-page__draft">Тестовая версия. Документ-заглушка, не является действующей редакцией.</p>}
		<div class="information-page__content"><slot /></div>
	</article>
</Base>

<style>
	.information-page {
		max-width: 840px;
		margin: 0 auto;
		padding: 40px var(--site-gutter) 64px;
		font-family: Manrope, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
		color: #1f2420;
		overflow-wrap: anywhere;
	}
	.information-page__breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 28px;
		color: #687067;
		font-size: 13px;
	}
	.information-page__breadcrumbs a { color: inherit; }
	.information-page h1 { margin: 0 0 24px; font-size: clamp(28px, 4vw, 40px); line-height: 1.2; }
	.information-page__draft { margin: 0 0 32px; padding: 16px 20px; border-radius: 10px; background: #f2f6fa; font-size: 14px; line-height: 1.7; color: #566575; }
	.information-page__content :global(h2) { margin: 32px 0 12px; font-size: 20px; line-height: 1.4; }
	.information-page__content :global(p) { margin: 0 0 16px; line-height: 1.8; color: #596259; }
	.information-page__content :global(a) { color: #0475df; text-underline-offset: 3px; }
</style>

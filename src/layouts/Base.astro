---
import { getSiteSettings } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SearchBox from "../components/SearchBox.astro";
import {
	cityCategoryHref,
	cityHref,
	countryHref,
	getCityTags,
	getTopCities,
	getTopCountries,
} from "../lib/travel-db.js";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	searchCity?: {
		id: string;
		name?: string | null;
		slug?: string | null;
		country_slug?: string | null;
		country_url?: string | null;
		in_obj_phrase?: string | null;
	};
}

const { title, pageTitle, description, image, canonical, content, searchCity } = Astro.props;
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const navItems = [
	{ label: "Страны", url: "/countries" },
	{ label: "Города", url: "/cities" },
	{ label: "Экскурсии", url: "/excursions" },
];

const footerLinks = [
	{ label: "Популярные экскурсии", url: "/excursions" },
	{ label: "Страны", url: "/countries" },
	{ label: "Города", url: "/cities" },
	{ label: "О проекте", url: "/about" },
];

const socialLinks = [
	{ label: "ВКонтакте", url: "#", icon: "vk" },
	{ label: "Telegram", url: "#", icon: "telegram" },
	{ label: "YouTube", url: "#", icon: "youtube" },
];

const offerLabel = (count: number) => {
	const mod10 = count % 10;
	const mod100 = count % 100;

	if (mod10 === 1 && mod100 !== 11) return "предложение";
	if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return "предложения";
	return "предложений";
};

const excursionLabel = (count: number) => {
	const mod10 = count % 10;
	const mod100 = count % 100;

	if (mod10 === 1 && mod100 !== 11) return "экскурсия";
	if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return "экскурсии";
	return "экскурсий";
};

const cityPhrase = searchCity?.in_obj_phrase || (searchCity?.name ? `в ${searchCity.name}` : "");
const headerSuggestionsTitle = searchCity
	? `Популярные рубрики ${cityPhrase}`
	: "Популярные направления";

const headerSuggestions = searchCity
	? (await getCityTags(searchCity.id, 12)).rows
		.filter((tag) => tag.name.toLowerCase() !== "все" && tag.slug !== "all" && tag.slug !== "vse")
		.slice(0, 10)
		.map((tag) => ({
			title: tag.name,
			subtitle: "Рубрика",
			count: tag.experience_count,
			countLabel: excursionLabel(tag.experience_count),
			href: cityCategoryHref(searchCity, tag),
		}))
	: [
		...(await getTopCountries(6)).rows.map((country) => ({
			title: country.name,
			subtitle: null,
			count: country.experience_count,
			countLabel: offerLabel(country.experience_count),
			href: countryHref(country),
		})),
		...(await getTopCities(5)).rows.map((city) => ({
			title: city.name,
			subtitle: city.country_name,
			count: city.experience_count,
			countLabel: offerLabel(city.experience_count),
			href: cityHref(city),
		})),
	];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<nav class="site-header__nav" aria-label="Основная навигация">
				<a class="brand-link" href="/" aria-label={siteTitle}>
					<picture>
						<source srcset="/gidmi-logo.webp" type="image/webp" />
						<img class="brand-link__mark" src="/gidmi-logo.png" alt="" />
					</picture>
					<span>{siteTitle}</span>
				</a>
				<div class="site-header__links">
					{
						navItems.map((item) => (
							<a href={item.url}>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="site-header__search">
					<SearchBox variant="header" placeholder="Найти направление" resultsListId="desktop-search-results" />
					{
						headerSuggestions.length > 0 && (
							<div class="site-header__desktop-suggestions">
								<div class="site-header__popular" aria-label={headerSuggestionsTitle}>
									<div class="site-header__popular-title">
										<span class="site-header__popular-title-default">{headerSuggestionsTitle}</span>
										<span class="site-header__popular-title-results">Результаты поиска</span>
									</div>
									<div class="site-header__popular-list site-header__popular-destinations">
										{headerSuggestions.map((item) => (
											<a class="site-header__popular-item" href={item.href}>
												<span class="site-header__popular-icon" aria-hidden="true">
													<svg viewBox="0 0 24 24">
														<path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Zm0-9.2a2.8 2.8 0 1 1 0-5.6 2.8 2.8 0 0 1 0 5.6Z" />
													</svg>
												</span>
												<span class="site-header__popular-copy">
													<span class="site-header__popular-name">
														{item.title} · {item.count.toLocaleString("ru-RU")} {item.countLabel}
													</span>
													{item.subtitle && <span class="site-header__popular-subtitle">{item.subtitle}</span>}
												</span>
											</a>
										))}
									</div>
									<ul
										id="desktop-search-results"
										class="site-header__popular-list site-header__popular-results ts-dropdown"
										role="listbox"
										hidden
										data-search-list
									></ul>
								</div>
							</div>
						)
					}
				</div>
				<div class="site-header__actions">
					<button
						class="site-header__icon site-header__icon--menu"
						type="button"
						aria-label="Открыть меню"
						aria-controls="mobile-menu"
						aria-expanded="false"
						data-header-toggle="menu"
					>
						<span aria-hidden="true"></span>
					</button>
					<button
						class="site-header__icon site-header__icon--search"
						type="button"
						aria-label="Открыть поиск"
						aria-controls="mobile-search"
						aria-expanded="false"
						data-header-toggle="search"
					>
						<span aria-hidden="true"></span>
					</button>
				</div>
				<div class="site-header__panel site-header__panel--menu" id="mobile-menu" hidden data-header-panel="menu">
					{
						navItems.map((item) => (
							<a href={item.url}>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="site-header__panel site-header__panel--search" id="mobile-search" hidden data-header-panel="search">
					<SearchBox variant="header" placeholder="Куда вы собираетесь?" resultsListId="mobile-search-results" />
					{
						headerSuggestions.length > 0 && (
							<div class="site-header__popular" aria-label={headerSuggestionsTitle}>
								<div class="site-header__popular-title">
									<span class="site-header__popular-title-default">{headerSuggestionsTitle}</span>
									<span class="site-header__popular-title-results">Результаты поиска</span>
								</div>
								<div class="site-header__popular-list site-header__popular-destinations">
									{headerSuggestions.map((item) => (
										<a class="site-header__popular-item" href={item.href}>
											<span class="site-header__popular-icon" aria-hidden="true">
												<svg viewBox="0 0 24 24">
													<path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Zm0-9.2a2.8 2.8 0 1 1 0-5.6 2.8 2.8 0 0 1 0 5.6Z" />
												</svg>
											</span>
											<span class="site-header__popular-copy">
												<span class="site-header__popular-name">
													{item.title} · {item.count.toLocaleString("ru-RU")} {item.countLabel}
												</span>
												{item.subtitle && <span class="site-header__popular-subtitle">{item.subtitle}</span>}
											</span>
										</a>
									))}
								</div>
								<ul
									id="mobile-search-results"
									class="site-header__popular-list site-header__popular-results ts-dropdown"
									role="listbox"
									hidden
									data-search-list
								></ul>
							</div>
						)
					}
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__social" aria-label="Социальные сети">
					{
						socialLinks.map((item) => (
							<a href={item.url} aria-label={item.label} title={item.label}>
								{
									item.icon === "vk" && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M13.3 17.3c-5.5 0-8.7-3.8-8.8-10.1h2.8c.1 4.6 2.1 6.5 3.7 6.9V7.2h2.7v3.9c1.6-.2 3.2-2 3.8-3.9h2.7c-.5 2.3-2.3 4.1-3.5 4.9 1.2.7 3.2 2.2 4 5.2h-3c-.6-1.8-2.1-3.2-4-3.5v3.5h-.4Z" />
										</svg>
									)
								}
								{
									item.icon === "telegram" && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M20.7 4.4 17.9 18c-.2 1-.8 1.2-1.6.8l-4.4-3.2-2.1 2c-.2.2-.4.4-.9.4l.3-4.5 8.2-7.4c.4-.3-.1-.5-.5-.2L6.8 12.3 2.4 11c-1-.3-1-1 .2-1.4l17-6.5c.8-.3 1.5.2 1.1 1.3Z" />
										</svg>
									)
								}
								{
									item.icon === "youtube" && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M21.6 7.2s-.2-1.5-.9-2.1c-.8-.9-1.8-.9-2.2-.9C15.4 4 12 4 12 4h-.1s-3.4 0-6.5.2c-.4 0-1.4 0-2.2.9-.7.6-.9 2.1-.9 2.1S2 9 2 10.8v1.7c0 1.8.3 3.6.3 3.6s.2 1.5.9 2.1c.8.9 1.9.9 2.4 1 1.7.2 6.4.2 6.4.2s3.4 0 6.5-.2c.4-.1 1.4-.1 2.2-1 .7-.6.9-2.1.9-2.1s.3-1.8.3-3.6v-1.7c0-1.8-.3-3.6-.3-3.6ZM10 14.5v-6l5.5 3-5.5 3Z" />
										</svg>
									)
								}
							</a>
						))
					}
				</div>
				<nav class="site-footer__nav" aria-label="Навигация в подвале">
					{
						footerLinks.map((item) => (
							<a href={item.url}>{item.label}</a>
						))
					}
				</nav>
				<div class="site-footer__brand">
					<a href="/">{siteTitle}</a>
					<p>{siteTagline}</p>
					<p class="site-footer__copyright">© {new Date().getFullYear()} {siteTitle}</p>
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
		<script is:inline>
			(() => {
				const toggles = Array.from(document.querySelectorAll("[data-header-toggle]"));
				const panels = Array.from(document.querySelectorAll("[data-header-panel]"));

				const closePanels = (except) => {
					panels.forEach((panel) => {
						if (panel.dataset.headerPanel === except) return;
						panel.hidden = true;
					});

					toggles.forEach((toggle) => {
						if (toggle.dataset.headerToggle === except) return;
						toggle.setAttribute("aria-expanded", "false");
					});
				};

				toggles.forEach((toggle) => {
					toggle.addEventListener("click", () => {
						const target = toggle.dataset.headerToggle;
						const panel = panels.find((item) => item.dataset.headerPanel === target);
						if (!panel) return;

						const willOpen = panel.hidden;
						closePanels(willOpen ? target : undefined);
						panel.hidden = !willOpen;
						toggle.setAttribute("aria-expanded", String(willOpen));

						if (willOpen && target === "search") {
							window.requestAnimationFrame(() => {
								panel.querySelector("input[type='search']")?.focus();
							});
						}
					});
				});

				document.addEventListener("mousedown", (event) => {
					if (event.target.closest(".site-header")) return;
					closePanels();
				});

				document.addEventListener("keydown", (event) => {
					if (event.key !== "Escape") return;
					closePanels();
				});
			})();
		</script>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		border-bottom: 1px solid rgba(31, 36, 32, 0.1);
		background: #fff;
		backdrop-filter: blur(14px);
	}

	.site-header__nav {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) minmax(260px, 360px);
		align-items: center;
		gap: 18px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 12px 24px;
	}

	.site-header__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 18px;
		min-width: 0;
	}

	.site-header__links a {
		color: #3f463f;
		text-decoration: none;
		font-weight: 700;
		white-space: nowrap;
	}

	.site-header__links a:hover {
		color: #1f2420;
	}

	.site-header__search {
		position: relative;
		min-width: 0;
	}

	.site-header__desktop-suggestions {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 45;
		display: none;
		width: min(440px, calc(100vw - 32px));
		max-height: calc(100dvh - 90px);
		overflow-y: auto;
		padding: 16px;
		border: 1px solid rgba(31, 36, 32, 0.1);
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 18px 50px rgba(31, 36, 32, 0.16);
	}

	.site-header__search:focus-within .site-header__desktop-suggestions {
		display: block;
	}

	.site-header__popular {
		display: grid;
		gap: 16px;
		background: #fff;
	}

	.site-header__popular-title {
		color: #8392a0;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: none;
	}

	.site-header__popular-list {
		display: grid;
		gap: 14px;
	}

	.site-header__popular-results[hidden] {
		display: none;
	}

	.site-header__popular-results {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-header__popular-title-results {
		display: none;
	}

	.site-header__popular:has(.site-header__popular-results:not([hidden])) .site-header__popular-destinations,
	.site-header__popular:has(.site-header__popular-results:not([hidden])) .site-header__popular-title-default {
		display: none;
	}

	.site-header__popular:has(.site-header__popular-results:not([hidden])) .site-header__popular-title-results {
		display: inline;
	}

	.site-header__popular-item {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr);
		align-items: center;
		gap: 14px;
		min-height: 44px;
		color: #020d1a;
		text-decoration: none;
	}

	.site-header__popular-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 8px;
		background: #efeff1;
		color: #1f2420;
	}

	.site-header__popular-icon svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
	}

	.site-header__popular-copy {
		display: grid;
		gap: 2px;
		min-width: 0;
	}

	.site-header__popular-name {
		color: #020d1a;
		font-size: 1rem;
		line-height: 1.25;
		font-weight: 600;
	}

	.site-header__popular-subtitle {
		color: #8392a0;
		font-size: 0.9rem;
		line-height: 1.25;
		font-weight: 500;
	}

	.site-header__popular-item:hover .site-header__popular-name {
		color: #315d63;
	}

	.site-header__desktop-suggestions :global(.ts-dropdown) {
		position: static;
		width: auto;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: #fff;
		box-shadow: none;
		overflow: visible;
	}

	.site-header__actions,
	.site-header__panel {
		display: none;
	}

	.site-header__icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(31, 36, 32, 0.14);
		border-radius: 8px;
		color: #1f2420;
		background: #fff;
		cursor: pointer;
	}

	.site-header__icon:hover,
	.site-header__icon[aria-expanded="true"] {
		border-color: #315d63;
		color: #fff;
		background: #315d63;
	}

	.site-header__icon--menu span,
	.site-header__icon--menu::before,
	.site-header__icon--menu::after {
		width: 18px;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
	}

	.site-header__icon--menu::before,
	.site-header__icon--menu::after {
		content: "";
		position: absolute;
	}

	.site-header__icon--menu::before {
		transform: translateY(-6px);
	}

	.site-header__icon--menu::after {
		transform: translateY(6px);
	}

	.site-header__icon--search span {
		position: relative;
		width: 16px;
		height: 16px;
		border: 2px solid currentColor;
		border-radius: 50%;
	}

	.site-header__icon--search span::after {
		content: "";
		position: absolute;
		right: -6px;
		bottom: -4px;
		width: 8px;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transform: rotate(45deg);
		transform-origin: center;
	}

	.site-footer {
		border-top: 1px solid rgba(31, 36, 32, 0.12);
		background: #1f2420;
		color: rgba(255, 255, 255, 0.72);
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: auto minmax(180px, 1fr) auto;
		align-items: start;
		gap: 32px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 42px 24px;
	}

	.site-footer a {
		color: #fff;
		text-decoration: none;
	}

	.site-footer__brand > a {
		display: inline-block;
		font-size: 1.45rem;
		font-weight: 900;
	}

	:global(.brand-link) {
		display: flex !important;
		align-items: center;
		gap: 10px;
		flex-direction: row !important;
		margin-right: 0 !important;
		color: #1f2420;
		font-weight: 850;
		text-decoration: none;
		white-space: nowrap;
	}

	:global(.brand-link__mark) {
		width: auto !important;
		height: 42px !important;
		object-fit: contain;
		display: block;
	}

	.site-footer p {
		margin: 10px 0 0;
		line-height: 1.55;
	}

	.site-footer__nav {
		display: grid;
		gap: 10px;
	}

	.site-footer__copyright {
		color: rgba(255, 255, 255, 0.58);
	}

	.site-footer__social {
		display: flex;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 12px;
	}

	.site-footer__social a {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		color: #fff;
		opacity: 0.86;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.site-footer__social a:hover {
		opacity: 1;
		transform: translateY(-1px);
	}

	.site-footer__social svg {
		width: 24px;
		height: 24px;
		fill: currentColor;
	}

	.site-header .site-header__search :global(.ts-wrap--header) {
		max-width: 360px;
		margin-left: auto;
	}

	@media (max-width: 760px) {
		.site-header__nav {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 10px 12px;
			padding: 12px 18px;
		}

		.site-header__links {
			display: none;
		}

		.site-header__search {
			display: none;
		}

		.site-header__actions {
			display: flex;
			gap: 8px;
			align-items: center;
			justify-content: flex-end;
		}

		.site-header__panel {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			z-index: 45;
		}


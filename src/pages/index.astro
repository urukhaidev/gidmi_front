---
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import {
	cityHref,
	countryHref,
	experienceHref,
	getHomeTravelData,
} from "../lib/travel-db.js";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

resolveStarterSiteIdentity(await getSiteSettings());
const { countries, cities, experiences, errors } =
	await getHomeTravelData("", 20, 16);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=180, stale-while-revalidate=60",
);

const heroImage =
	experiences.find((item) => item.image_url)?.image_url ??
	cities.find((item) => item.image_url)?.image_url ??
	countries.find((item) => item.image_url)?.image_url;

const hasTravelData =
	countries.length > 0 || cities.length > 0 || experiences.length > 0;

const formatCount = (value: number | string | null | undefined) => Number(value ?? 0).toLocaleString("ru-RU");
const formatDuration = (value: number | string | null | undefined) => {
	const duration = String(value ?? "").trim().replace(/\s*ч\.?$/i, "");
	return duration.replace(/([.,]\d*?)0+$/, "$1").replace(/[.,]$/, "");
};
const typeLabels: Record<string, string> = {
	private: "Индивидуальная",
	individual: "Индивидуальная",
	group: "Групповая",
	mini_group: "Мини-группа",
	"mini-group": "Мини-группа",
	minigroup: "Мини-группа",
	small_group: "Мини-группа",
	"small-group": "Мини-группа",
};
const movementLabels: Record<string, string> = {
	foot: "пешком",
	car: "на машине",
	bus: "на автобусе",
	museum: "в музее",
	motorship: "на теплоходе",
	speedboat: "на катере",
	boat: "на лодке",
	yacht: "на яхте",
	sailing: "на яхте",
	bicycle: "на велосипеде",
	other: "другое",
};
const formatLabels: Record<string, string> = {
	waterwalk: "на воде",
	quest: "квест",
	photosession: "фотосессия",
	activity: "активность",
	master_class: "мастер-класс",
	audioguide: "аудиогид",
	ticket: "билет",
};
const labelFor = (labels: Record<string, string>, value: string | null | undefined) => {
	const key = String(value ?? "").trim().toLowerCase();
	return key ? labels[key] : null;
};
const experienceBadgeLabel = (experience: any) => [
	labelFor(typeLabels, experience.type),
	labelFor(movementLabels, experience.movement_type) ?? labelFor(formatLabels, experience.format),
].filter(Boolean).join(" ∙ ");
const formatPrice = (experience: any) => {
	if (experience.price_value_string) return experience.price_value_string;
	if (!experience.price_value) return null;

	const price = Number(experience.price_value);
	const currency = String(experience.price_currency ?? "RUB").trim() || "RUB";

	if (Number.isNaN(price)) return null;

	try {
		return new Intl.NumberFormat("ru-RU", {
			style: "currency",
			currency,
			maximumFractionDigits: 0,
		}).format(price);
	} catch {
		return `${price.toLocaleString("ru-RU")} ${currency}`;
	}
};
---

<Base
	title="Экскурсии"
	description="Экскурсии, города, страны и маршруты для путешествий."
>
	<section class="hero">
		<div class="hero__bg">
			{heroImage && <img class="hero__image" src={heroImage} alt="" />}
			<div class="hero__shade"></div>
		</div>
		<div class="hero__inner">
			<h1>Гидми - экскурсии по всему миру</h1>
		<p class="hero__lead">
			Найдите страну, город или экскурсию и выберите маршрут по рейтингу,
			цене и отзывам.
		</p>

			<SearchBox variant="hero" placeholder="Куда вы собираетесь?" />
		</div>
	</section>

	{
		!hasTravelData && (
			<section class="notice">
				<h2>Данные подключены, но строки сейчас не видны</h2>
				<p>
					Read-only роль подключается к Supabase, но RLS включен на таблицах и
					политик SELECT для этой роли нет. После открытия чтения эти блоки
					автоматически наполнятся странами, городами и экскурсиями.
				</p>
				{errors.length > 0 && (
					<ul>
						{errors.map((error) => (
							<li>{error}</li>
						))}
					</ul>
				)}
			</section>
		)
	}

	<section class="section">
		<div id="countries" class="section__heading">
			<h2>Популярные страны</h2>
		</div>
		<div class="destination-grid">
			{
				countries.length > 0 ? (
					countries.map((country, index) => (
						<a
							class="destination-card"
							href={countryHref(country)}
						>
							{country.image_url && <img src={country.image_url} alt="" loading={index < 6 ? "eager" : "lazy"} />}
							<span class="destination-card__shade"></span>
							<span class="destination-card__content">
								<span class="destination-card__name">{country.name}</span>
								<small>{formatCount(country.experience_count)} экскурсий</small>
							</span>
						</a>
					))
				) : (
					<div class="empty-card">Страны появятся после открытия SELECT-доступа.</div>
				)
			}
		</div>
		<div class="section-more">
			<a href="/countries">Все страны <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="section section--muted">
		<div id="cities" class="section__heading">
			<h2>Популярные города</h2>
		</div>
		<div class="city-grid">
			{
				cities.length > 0 ? (
					cities.map((city) => (
						<a
							class="city-card"
							href={cityHref(city)}
						>
							<div class="city-card__media">
								{city.image_url && <img src={city.image_url} alt="" loading="lazy" />}
							</div>
							<div class="city-card__body">
								<h3>{city.name}</h3>
								<p>
									<span>{formatCount(city.experience_count)} экскурсий</span>
								</p>
							</div>
						</a>
					))
				) : (
					<div class="empty-card">Города появятся после открытия SELECT-доступа.</div>
				)
			}
		</div>
		<div class="section-more">
			<a href="/cities">Все города <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="section">
		<div id="popular" class="section__heading">
			<h2>Популярные экскурсии</h2>
		</div>
		<div class="experience-grid">
			{
				experiences.length > 0 ? (
					experiences.map((experience) => (
						<article class="experience-card">
							<a
								href={experienceHref(experience)}
							>
								<div class="experience-card__media">
									{experience.image_url && (
										<img
											src={experience.image_url}
											alt=""
											loading="lazy"
										/>
									)}
									{experienceBadgeLabel(experience) && (
										<span class="experience-card__badge">{experienceBadgeLabel(experience)}</span>
									)}
								</div>
								<div class="experience-card__body">
									<div class="experience-card__meta">
										{experience.duration && <span><span class="experience-card__meta-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm1 3v5.1l3.4 2-1 1.7L11 13.2V7h2Z" /></svg></span>{formatDuration(experience.duration)} ч.</span>}
										{experience.rating && <span><span class="experience-card__meta-icon" aria-hidden="true">★</span>{experience.rating}</span>}
										{experience.review_count && (
											<span><span class="experience-card__meta-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5h16v10H9.2L4 19.5v-14Zm2 2v8l2.5-2H18v-6H6Z" /><path d="M8.5 10.5a1.2 1.2 0 1 1 2.4 0 1.2 1.2 0 0 1-2.4 0Zm3.4 0a1.2 1.2 0 1 1 2.4 0 1.2 1.2 0 0 1-2.4 0Zm3.4 0a1.2 1.2 0 1 1 2.4 0 1.2 1.2 0 0 1-2.4 0Z" /></svg></span>{formatCount(experience.review_count)} отзывов</span>
										)}
									</div>
									<h3>{experience.title}</h3>
									{experience.tagline && <p>{experience.tagline}</p>}
									<div class="experience-card__footer">
										{formatPrice(experience) && (
											<strong>{formatPrice(experience)}</strong>
										)}
										{experience.city_name && <span>{experience.city_name}</span>}
									</div>
								</div>
							</a>
						</article>
					))
				) : (
					<div class="empty-card">Экскурсии появятся после открытия SELECT-доступа.</div>
				)
			}
		</div>
	</section>

	<style>
		:global(:root) {
			--site-gutter: 24px;
			--site-content-max: 1200px;
		}

		:global(body) {
			margin: 0;
			color: #1f2420;
			background: #fff;
			font-family:
				Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
				sans-serif;
		}

		:global(header) {
			position: sticky;
			top: 0;
			z-index: 20;
			border-bottom: 1px solid rgba(31, 36, 32, 0.1);
			background: rgba(255, 255, 255, 0.94);
			backdrop-filter: blur(14px);
		}

		:global(header nav) {
			display: flex;
			align-items: center;
			gap: 18px;
			max-width: 1200px;
			margin: 0 auto;
			padding: 16px 24px;
		}

		:global(header nav > a:first-child) {
			margin-right: auto;
			color: #1f2420;
			text-decoration: none;
		}

		:global(header nav a) {
			color: #3f463f;
			text-decoration: none;
		}

		:global(main) {
			overflow-x: clip;
		}

		.hero {
			position: relative;
			min-height: 620px;
			display: grid;
			align-items: center;
			background:
				linear-gradient(135deg, #0486fe, #7f6749 58%, #25332e),
				#0486fe;
		}

		.hero__bg {
			position: absolute;
			inset: 0;
			overflow: hidden;
			pointer-events: none;
		}

		.hero__image {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero__shade {
			position: absolute;
			inset: 0;
			background:
				linear-gradient(90deg, rgba(12, 18, 16, 0.82), rgba(12, 18, 16, 0.35)),
				linear-gradient(0deg, rgba(12, 18, 16, 0.62), rgba(12, 18, 16, 0.08));
		}

		.hero__inner {
			position: relative;
			z-index: 1;
			width: min(var(--site-content-max), calc(100% - (var(--site-gutter) * 2)));
			margin: 0 auto;
			padding: 96px 0;
			color: #fff;
		}

		h1,
		h2,
		h3,
		p {
			text-wrap: pretty;
		}

		h1 {
			max-width: 820px;
			margin: 0;
			font-size: clamp(2.8rem, 5vw, 4.5rem);
			line-height: 0.94;
			letter-spacing: 0;
		}

		.hero__lead {
			max-width: 690px;
			margin: 24px 0 0;
			color: rgba(255, 255, 255, 0.86);
			font-size: 1.18rem;
			line-height: 1.65;
		}

		.notice {
			max-width: var(--site-content-max);
			margin: 34px auto 0;
			padding: 24px;
			border: 1px solid rgba(31, 36, 32, 0.12);
			border-radius: 8px;
			background: #fff;
		}

		.notice h2 {
			margin: 0 0 10px;
			font-size: 1.25rem;
		}

		.notice p {
			max-width: 880px;
			margin: 0;
			color: #555d54;
			line-height: 1.6;
		}

		.section {
			max-width: var(--site-content-max);
			margin: 0 auto;
			padding: 56px var(--site-gutter);
		}

		.section--muted {
			max-width: none;
			padding-left: max(
				var(--site-gutter),
				calc((100vw - var(--site-content-max) - (var(--site-gutter) * 2)) / 2 + var(--site-gutter))
			);
			padding-right: max(
				var(--site-gutter),
				calc((100vw - var(--site-content-max) - (var(--site-gutter) * 2)) / 2 + var(--site-gutter))
			);
			background: #E5F0FF;
		}

		.section__heading {
			margin-bottom: 24px;
		}

		.section__heading h2 {
			max-width: 780px;
			margin: 0;
			font-size: clamp(1.8rem, 3vw, 2.5rem);
			line-height: 1;
			letter-spacing: 0;
		}

		.destination-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 14px;
		}

		.destination-card {
			position: relative;
			display: flex;
			align-items: flex-end;
			min-height: 148px;
			overflow: hidden;
			border: 0;
			border-radius: 8px;
			color: #fff;
			background: #0486fe;
			text-decoration: none;
			box-shadow: 0 1px 0 rgba(31, 36, 32, 0.08);
		}

		.destination-card img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.2s ease;
		}

		.destination-card:hover img {
			transform: scale(1.025);
		}

		.destination-card__shade {
			position: absolute;
			inset: 0;
			background: linear-gradient(
				180deg,
				rgba(12, 18, 16, 0) 22%,
				rgba(12, 18, 16, 0.28) 58%,
				rgba(12, 18, 16, 0.76) 100%
			);
		}

		.destination-card__content {
			position: relative;
			display: grid;
			gap: 5px;
			width: 100%;
			padding: 16px;
			text-shadow: 0 1px 14px rgba(0, 0, 0, 0.42);
		}

		.destination-card__name {
			font-size: 1.12rem;
			font-weight: 400;
		}

		.destination-card small {
			color: rgba(255, 255, 255, 0.86);
			font-size: 0.95rem;
		}

		.city-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 18px;
		}

		.section-more {
			display: flex;
			justify-content: center;
			margin-top: 22px;
		}

		.section-more a {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			min-height: 36px;
			padding: 0 14px;
			border: 1px solid #0486fe;
			border-radius: 8px;
			color: #fff;
			background: #0486fe;
			font-size: 0.94rem;
			font-weight: 800;
			text-decoration: none;
			transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
		}

		.section-more a:hover {
			border-color: #185fa8;
			background: #185fa8;
			transform: translateY(-1px);
		}

		.section-more span {
			line-height: 1;
		}

		.experience-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 18px;
		}

		.empty-card {
			padding: 24px;
			border: 1px solid rgba(31, 36, 32, 0.12);
			border-radius: 8px;
			color: #555d54;
			background: #fff;
			line-height: 1.55;
		}

		.city-card,
		.experience-card {
			border-radius: 8px;
			background: #fff;
			overflow: hidden;
			box-shadow: 0 1px 0 rgba(31, 36, 32, 0.08);
		}

		.city-card {
			display: flex;
			min-width: 0;
			flex-direction: column;
			color: #1f2420;
			text-decoration: none;
		}

		.city-card__media {
			height: 128px;
			background:
				linear-gradient(135deg, rgba(49, 93, 99, 0.9), rgba(127, 103, 73, 0.9)),
				#0486fe;
			overflow: hidden;
		}

		.city-card__media img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.city-card__body {
			padding: 14px;
		}

		.city-card h3 {
			margin: 0;
			font-size: 1.02rem;
			line-height: 1.25;
		}

		.experience-card h3 {
			margin: 0;
			font-size: 1.18rem;
			line-height: 1.22;
		}

		.city-card p {
			display: flex;
			flex-wrap: wrap;
			gap: 6px 10px;
			margin: 7px 0 0;
			color: #687067;
			font-size: 0.94rem;
		}

		.experience-card a {
			display: flex;
			flex-direction: column;
			min-height: 100%;
			color: inherit;
			text-decoration: none;
		}

		.experience-card__media {
			position: relative;
			height: 210px;
			background:
				linear-gradient(135deg, rgba(49, 93, 99, 0.9), rgba(127, 103, 73, 0.9)),
				#0486fe;
			overflow: hidden;
		}

		.experience-card__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.experience-card__media::after {
			content: "";
			position: absolute;
			inset: 0 0 auto;
			height: 42%;
			background: linear-gradient(180deg, rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0));
			pointer-events: none;
		}

		.experience-card__badge {
			position: absolute;
			top: 14px;
			left: 14px;
			z-index: 1;
			max-width: calc(100% - 28px);
			color: #fff;
			font-size: 0.98rem;
			line-height: 1.2;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.experience-card__body {
			display: flex;
			flex-direction: column;
			gap: 12px;
			padding: 20px;
			flex: 1;
		}

		.experience-card__meta,
		.experience-card__footer {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			align-items: center;
			color: #687067;
			font-size: 0.92rem;
		}

		.experience-card__meta span {
			display: inline-flex;
			align-items: center;
			gap: 5px;
		}

		.experience-card__meta-icon {
			display: inline-grid;
			place-items: center;
			width: 16px;
			height: 16px;
			color: #0486fe;
			flex: 0 0 auto;
		}

		.experience-card__meta-icon svg {
			width: 16px;
			height: 16px;
			fill: currentColor;
		}

		.experience-card p {
			margin: 0;
			color: #555d54;
			line-height: 1.5;
		}

		.experience-card__footer {
			margin-top: auto;
			justify-content: space-between;
		}

		.experience-card__footer strong {
			color: #1f2420;
			font-size: 1.05rem;
		}

		@media (min-width: 761px) and (max-width: 1440px) {
			:global(:root) {
				--site-gutter: 48px;
				--site-content-max: 1104px;
			}
		}

		@media (max-width: 760px) {
			:global(:root) {
				--site-gutter: 18px;
				--site-content-max: 1200px;
			}

			:global(header nav) {
				align-items: flex-start;
				flex-wrap: wrap;
				padding: 14px 18px;
			}

			.hero {
				min-height: 560px;
			}

			.hero__inner {
				padding: 58px 0 42px;
			}

			.section {
				padding: 42px var(--site-gutter);
			}

			.section--muted {
				padding-left: var(--site-gutter);
				padding-right: var(--site-gutter);
			}

			.destination-grid,
			.city-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
	</style>
</Base>

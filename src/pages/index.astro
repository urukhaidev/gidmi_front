---
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import {
	cityHref,
	countryHref,
	experienceHref,
	getHomeTravelData,
} from "../lib/travel-db.js";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

resolveStarterSiteIdentity(await getSiteSettings());
const { countries, cities, experiences, errors } =
	await getHomeTravelData("", 20, 20);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=180, stale-while-revalidate=60",
);

const heroImage =
	experiences.find((item) => item.image_url)?.image_url ??
	cities.find((item) => item.image_url)?.image_url ??
	countries.find((item) => item.image_url)?.image_url;

const hasTravelData =
	countries.length > 0 || cities.length > 0 || experiences.length > 0;

const formatCount = (value: number | string | null | undefined) => Number(value ?? 0).toLocaleString("ru-RU");
const formatPrice = (experience: any) => {
	if (experience.price_value_string) return experience.price_value_string;
	if (!experience.price_value) return null;

	const price = Number(experience.price_value);
	const currency = String(experience.price_currency ?? "RUB").trim() || "RUB";

	if (Number.isNaN(price)) return null;

	try {
		return new Intl.NumberFormat("ru-RU", {
			style: "currency",
			currency,
			maximumFractionDigits: 0,
		}).format(price);
	} catch {
		return `${price.toLocaleString("ru-RU")} ${currency}`;
	}
};
---

<Base
	title="Экскурсии"
	description="Экскурсии, города, страны и маршруты для путешествий."
>
	<section class="hero">
		<div class="hero__bg">
			{heroImage && <img class="hero__image" src={heroImage} alt="" />}
			<div class="hero__shade"></div>
		</div>
		<div class="hero__inner">
			<p class="eyebrow">Экскурсии по миру</p>
			<h1>Экскурсии по всему миру</h1>
		<p class="hero__lead">
			Найдите страну, город или экскурсию и выберите маршрут по рейтингу,
			цене и отзывам.
		</p>

			<SearchBox variant="hero" placeholder="Куда вы собираетесь?" />
		</div>
	</section>

	{
		!hasTravelData && (
			<section class="notice">
				<h2>Данные подключены, но строки сейчас не видны</h2>
				<p>
					Read-only роль подключается к Supabase, но RLS включен на таблицах и
					политик SELECT для этой роли нет. После открытия чтения эти блоки
					автоматически наполнятся странами, городами и экскурсиями.
				</p>
				{errors.length > 0 && (
					<ul>
						{errors.map((error) => (
							<li>{error}</li>
						))}
					</ul>
				)}
			</section>
		)
	}

	<section class="section">
		<div id="countries" class="section__heading">
			<p class="eyebrow">Направления</p>
			<h2>Топ 20 стран</h2>
		</div>
		<div class="destination-grid">
			{
				countries.length > 0 ? (
					countries.map((country, index) => (
						<a
							class="destination-card"
							href={countryHref(country)}
						>
							{country.image_url && <img src={country.image_url} alt="" loading={index < 6 ? "eager" : "lazy"} />}
							<span class="destination-card__shade"></span>
							<span class="destination-card__content">
								<span class="destination-card__name">{country.name}</span>
								<small>{formatCount(country.experience_count)} экскурсий</small>
							</span>
						</a>
					))
				) : (
					<div class="empty-card">Страны появятся после открытия SELECT-доступа.</div>
				)
			}
		</div>
		<div class="section-more">
			<a href="/countries">Все страны <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="section section--muted">
		<div id="cities" class="section__heading">
			<p class="eyebrow">Города</p>
			<h2>Топ 20 городов</h2>
		</div>
		<div class="city-grid">
			{
				cities.length > 0 ? (
					cities.map((city) => (
						<a
							class="city-card"
							href={cityHref(city)}
						>
							{city.image_url && <img src={city.image_url} alt="" loading="lazy" />}
							<div>
								<h3>{city.name}</h3>
								<p>{formatCount(city.experience_count)} экскурсий</p>
							</div>
						</a>
					))
				) : (
					<div class="empty-card">Города появятся после открытия SELECT-доступа.</div>
				)
			}
		</div>
		<div class="section-more">
			<a href="/cities">Все города <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="section">
		<div id="popular" class="section__heading">
			<p class="eyebrow">Популярное</p>
			<h2>Популярные экскурсии</h2>
		</div>
		<div class="experience-grid">
			{
				experiences.length > 0 ? (
					experiences.map((experience) => (
						<article class="experience-card">
							<a
								href={experienceHref(experience)}
							>
								<div class="experience-card__media">
									{experience.image_url && (
										<img
											src={experience.image_url}
											alt=""
											loading="lazy"
										/>
									)}
								</div>
								<div class="experience-card__body">
									<div class="experience-card__meta">
										{experience.rating && <span>★ {experience.rating}</span>}
										{experience.review_count && (
											<span>{formatCount(experience.review_count)} отзывов</span>
										)}
									</div>
									<h3>{experience.title}</h3>
									{experience.tagline && <p>{experience.tagline}</p>}
									<div class="experience-card__footer">
										{formatPrice(experience) && (
											<strong>{formatPrice(experience)}</strong>
										)}
										{experience.city_name && <span>{experience.city_name}</span>}
									</div>
								</div>
							</a>
						</article>
					))
				) : (
					<div class="empty-card">Экскурсии появятся после открытия SELECT-доступа.</div>
				)
			}
		</div>
	</section>

	<style>
		:global(body) {
			margin: 0;
			color: #1f2420;
			background: #fff;
			font-family:
				Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
				sans-serif;
		}

		:global(header) {
			position: sticky;
			top: 0;
			z-index: 20;
			border-bottom: 1px solid rgba(31, 36, 32, 0.1);
			background: rgba(255, 255, 255, 0.94);
			backdrop-filter: blur(14px);
		}

		:global(header nav) {
			display: flex;
			align-items: center;
			gap: 18px;
			max-width: 1200px;
			margin: 0 auto;
			padding: 16px 24px;
		}

		:global(header nav > a:first-child) {
			margin-right: auto;
			color: #1f2420;
			font-weight: 850;
			text-decoration: none;
		}

		:global(header nav a) {
			color: #3f463f;
			text-decoration: none;
			font-weight: 700;
		}

		:global(main) {
			overflow-x: clip;
		}

		.hero {
			position: relative;
			min-height: 620px;
			display: grid;
			align-items: end;
			background:
				linear-gradient(135deg, #315d63, #7f6749 58%, #25332e),
				#315d63;
		}

		.hero__bg {
			position: absolute;
			inset: 0;
			overflow: hidden;
			pointer-events: none;
		}

		.hero__image {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero__shade {
			position: absolute;
			inset: 0;
			background:
				linear-gradient(90deg, rgba(12, 18, 16, 0.82), rgba(12, 18, 16, 0.35)),
				linear-gradient(0deg, rgba(12, 18, 16, 0.62), rgba(12, 18, 16, 0.08));
		}

		.hero__inner {
			position: relative;
			z-index: 1;
			width: min(1200px, calc(100% - 48px));
			margin: 0 auto;
			padding: 96px 0 72px;
			color: #fff;
		}

		.eyebrow {
			margin: 0 0 12px;
			color: #cfa464;
			font-size: 0.78rem;
			font-weight: 850;
			letter-spacing: 0;
			text-transform: uppercase;
		}

		h1,
		h2,
		h3,
		p {
			text-wrap: pretty;
		}

		h1 {
			max-width: 820px;
			margin: 0;
			font-size: clamp(3.2rem, 8vw, 6.8rem);
			line-height: 0.94;
			letter-spacing: 0;
		}

		.hero__lead {
			max-width: 690px;
			margin: 24px 0 0;
			color: rgba(255, 255, 255, 0.86);
			font-size: 1.18rem;
			line-height: 1.65;
		}

		.notice {
			max-width: 1200px;
			margin: 34px auto 0;
			padding: 24px;
			border: 1px solid rgba(31, 36, 32, 0.12);
			border-radius: 8px;
			background: #fff;
		}

		.notice h2 {
			margin: 0 0 10px;
			font-size: 1.25rem;
		}

		.notice p {
			max-width: 880px;
			margin: 0;
			color: #555d54;
			line-height: 1.6;
		}

		.section {
			max-width: 1200px;
			margin: 0 auto;
			padding: 56px 24px;
		}

		.section--muted {
			max-width: none;
			padding-left: max(24px, calc((100vw - 1200px) / 2 + 24px));
			padding-right: max(24px, calc((100vw - 1200px) / 2 + 24px));
			background: #ece8dd;
		}

		.section__heading {
			margin-bottom: 24px;
		}

		.section__heading h2 {
			max-width: 780px;
			margin: 0;
			font-size: clamp(2rem, 4vw, 3.4rem);
			line-height: 1;
			letter-spacing: 0;
		}

		.destination-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 14px;
		}

		.destination-card {
			position: relative;
			display: flex;
			align-items: flex-end;
			min-height: 148px;
			overflow: hidden;
			border: 1px solid rgba(31, 36, 32, 0.12);
			border-radius: 8px;
			color: #fff;
			background: #315d63;
			text-decoration: none;
			box-shadow: 0 1px 0 rgba(31, 36, 32, 0.08);
		}

		.destination-card img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.2s ease;
		}

		.destination-card:hover img {
			transform: scale(1.025);
		}

		.destination-card__shade {
			position: absolute;
			inset: 0;
			background: linear-gradient(
				180deg,
				rgba(12, 18, 16, 0) 22%,
				rgba(12, 18, 16, 0.28) 58%,
				rgba(12, 18, 16, 0.76) 100%
			);
		}

		.destination-card__content {
			position: relative;
			z-index: 1;
			display: grid;
			gap: 5px;
			width: 100%;
			padding: 16px;
			text-shadow: 0 1px 14px rgba(0, 0, 0, 0.42);
		}

		.destination-card__name {
			font-size: 1.12rem;
			font-weight: 850;
		}

		.destination-card small {
			color: rgba(255, 255, 255, 0.86);
			font-size: 0.95rem;
		}

		.city-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 18px;
		}

		.section-more {
			display: flex;
			justify-content: center;
			margin-top: 22px;
		}

		.section-more a {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			min-height: 36px;
			padding: 0 14px;
			border: 1px solid #315d63;
			border-radius: 8px;
			color: #fff;
			background: #315d63;
			font-size: 0.94rem;
			font-weight: 800;
			text-decoration: none;
			transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
		}

		.section-more a:hover {
			border-color: #264d52;
			background: #264d52;
			transform: translateY(-1px);
		}

		.section-more span {
			line-height: 1;
		}

		.experience-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 18px;
		}

		.empty-card {
			padding: 24px;
			border: 1px solid rgba(31, 36, 32, 0.12);
			border-radius: 8px;
			color: #555d54;
			background: #fff;
			line-height: 1.55;
		}

		.city-card,
		.experience-card {
			border-radius: 8px;
			background: #fff;
			overflow: hidden;
			box-shadow: 0 1px 0 rgba(31, 36, 32, 0.08);
		}

		.city-card {
			display: grid;
			grid-template-columns: 92px 1fr;
			min-height: 112px;
			color: #1f2420;
			text-decoration: none;
		}

		.city-card img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			background: #315d63;
		}

		.city-card div {
			padding: 18px;
		}

		.city-card h3,
		.experience-card h3 {
			margin: 0;
			font-size: 1.18rem;
			line-height: 1.22;
		}

		.city-card p {
			margin: 8px 0 0;
			color: #687067;
		}

		.experience-card a {
			display: flex;
			flex-direction: column;
			min-height: 100%;
			color: inherit;
			text-decoration: none;
		}

		.experience-card__media {
			height: 210px;
			background:
				linear-gradient(135deg, rgba(49, 93, 99, 0.9), rgba(127, 103, 73, 0.9)),
				#315d63;
			overflow: hidden;
		}

		.experience-card__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.experience-card__body {
			display: flex;
			flex-direction: column;
			gap: 12px;
			padding: 20px;
			flex: 1;
		}

		.experience-card__meta,
		.experience-card__footer {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			align-items: center;
			color: #687067;
			font-size: 0.92rem;
		}

		.experience-card p {
			margin: 0;
			color: #555d54;
			line-height: 1.5;
		}

		.experience-card__footer {
			margin-top: auto;
			justify-content: space-between;
		}

		.experience-card__footer strong {
			color: #1f2420;
			font-size: 1.05rem;
		}

		@media (max-width: 760px) {
			:global(header nav) {
				align-items: flex-start;
				flex-wrap: wrap;
				padding: 14px 18px;
			}

			.hero {
				min-height: 560px;
			}

			.hero__inner {
				width: min(100% - 36px, 1200px);
				padding: 58px 0 42px;
			}

			.section {
				padding: 42px 18px;
			}

			.section--muted {
				padding-left: 18px;
				padding-right: 18px;
			}
		}
	</style>
</Base>

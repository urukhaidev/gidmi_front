---
import InformationPage from "../layouts/InformationPage.astro";
import PlaceholderPanel from "../components/PlaceholderPanel.astro";
---

<InformationPage title="Избранное" description="Место для ваших любимых экскурсий и планов на поездку.">
	<p>Все идеи для будущих путешествий — в одном месте.</p>
	<PlaceholderPanel
		icon="heart"
		title="Скоро здесь будут ваши любимые маршруты"
		text="Готовим возможность сохранять понравившиеся экскурсии и возвращаться к ним перед поездкой. А пока можно познакомиться с направлениями и выбрать город."
		actionLabel="Посмотреть направления"
		actionHref="/countries"
	/>
</InformationPage>

---
import Base from "../../layouts/Base.astro";
import PlaceCard from "../../components/PlaceCard.astro";
import TravelPageStyles from "../../components/TravelPageStyles.astro";
import SearchBox from "../../components/SearchBox.astro";
import { cityHref, getCities } from "../../lib/travel-db.js";

const { rows: cities, error } = await getCities(180);
const popularCities = cities.slice(0, 20);
const otherCities = cities.slice(20);
const formatCount = (value: number | string | null | undefined) => Number(value ?? 0).toLocaleString("ru-RU");

Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=60");
---

<Base title="Города" description="Города с экскурсиями и маршрутами.">
	<TravelPageStyles />
	<section class="page-hero">
		{cities[0]?.image_url && <img src={cities[0].image_url} alt="" />}
		<div class="page-hero__inner">
			<h1>Города</h1>
			<p class="page-lead">Найдите город и выберите экскурсию по рейтингу и отзывам.</p>
			<SearchBox variant="inline" placeholder="Поиск города, страны или экскурсии" />
		</div>
	</section>

		<section class="section">
		{error && <div class="empty-card">{error}</div>}
		<div class="section__heading">
			<h2>Популярные города</h2>
		</div>

		<div class="cities-grid">
			{
				popularCities.map((city, index) => (
					<PlaceCard
						href={cityHref(city)}
						name={city.name}
						count={city.experience_count}
						secondaryCount={city.guides_count}
						image={city.image_thumbnail || city.image_url}
						loading={index < 8 ? "eager" : "lazy"}
					/>
				))
			}
		</div>

		{
			otherCities.length > 0 && (
				<div class="city-list-wrap">
					<h3>Остальные города</h3>
					<ul class="city-list">
						{otherCities.map((city) => (
							<li>
								<a href={cityHref(city)}>
									{city.name}
									<span>{formatCount(city.experience_count)}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}
	</section>

	<style>
		.cities-grid {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 18px;
		}

		.city-list-wrap {
			margin-top: 32px;
		}

		.city-list-wrap h3 {
			margin: 0;
			font-size: 1.02rem;
			line-height: 1.25;
		}

		.city-list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 10px 18px;
			margin: 14px 0 0;
			padding: 0;
			list-style: none;
		}

		.city-list li {
			border-bottom: 1px solid rgba(31, 36, 32, 0.1);
		}

		.city-list a {
			display: flex;
			align-items: center;
			gap: 12px;
			justify-content: space-between;
			box-sizing: border-box;
			min-height: 44px;
			padding: 12px 0;
			color: #1f2420;
			font-weight: 750;
			text-decoration: none;
		}

		.city-list span {
			flex-shrink: 0;
			color: #687067;
			font-weight: 400;
		}

		@media (max-width: 1060px) {
			.cities-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 640px) {
			.cities-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Base>

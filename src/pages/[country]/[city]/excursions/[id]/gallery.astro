---
import { experienceHref, getExperience } from "../../../../../lib/travel-db.js";

const { id: paramId } = Astro.params;
const id = paramId ? paramId.split("-")[0] : "";
const experienceResult = await getExperience(id);
const experience = experienceResult.rows[0];

if (!experience) {
	return Astro.redirect("/404");
}

return Astro.redirect(`${experienceHref(experience)}/nohero${Astro.url.search}`, 301);
---
